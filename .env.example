# Every setting the BE reads. Values here are local examples only.
# Plain lines: the value for each stage is in ff-poc-hub config/be/<stage>.env (reviewed in PRs).
# Lines marked "# secret": the value is in Parameter Store /ff-poc/<stage>/be/<KEY>, never in git.
# The hub deploy checks every key here has a value before it starts the server.
APP_ENV=local
LOG_LEVEL=debug
APP_URL=http://localhost:3000
DB_HOST=localhost
DB_NAME=ff_local
DB_USERNAME=ff_app
REDIS_QUEUE_HOST=localhost
DB_PASSWORD= # secret
STRIPE_SECRET_KEY= # secret
SENDGRID_API_KEY= # secret
